# Скопируй в .env (или экспортируй как переменные окружения) и заполни.
# Обязателен только TG_BOT_TOKEN — остальное имеет разумные значения по умолчанию.

# --- обязательно ---
# Токен бота от @BotFather
TG_BOT_TOKEN=123456:ABCDEF-your-telegram-bot-token

# --- доступ (необязательно) ---
# Пусто = доступ всем. Иначе список Telegram user_id через запятую/пробел.
# Свой id можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# --- ffmpeg (необязательно) ---
# По умолчанию берётся системный ffmpeg/ffprobe из PATH.
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe

# --- параметры вывода (необязательно) ---
OUT_W=1080
OUT_H=1920
OUT_FPS=30
OUT_CRF=20
OUT_PRESET=fast
# Нормализовать вход к OUT_W×OUT_H (1 = да, рекомендуется).
NORMALIZE_INPUT=1

# --- интерфейс: кнопки числа версий ---
COUNT_CHOICES=1 3 5 10
MAX_COUNT=20

# --- сила уникализации (необязательно) ---
UNIQ_SPEED_MIN=0.97
UNIQ_SPEED_MAX=1.03
UNIQ_BRIGHTNESS=0.03
UNIQ_CONTRAST=0.05
UNIQ_SATURATION=0.07
UNIQ_GAMMA=0.05
UNIQ_HUE=2.0                 # ±градусы (больше — тонирует картинку)
UNIQ_COLORBALANCE=0.02       # сдвиг грейда (±0.07 давал цветовой каст — держи слабым)
UNIQ_ROTATE=1.0              # ±градусы микро-поворота (только при геометрии)
UNIQ_PITCH_CENTS=35          # ±центы микро-сдвига тона аудио (против аудио-хеша)
UNIQ_CRF_MIN=21
UNIQ_CRF_MAX=25
UNIQ_PRESET=veryfast         # пресет x264 для уникализации (быстрее ре-энкод)
# Геометрия (зум+микро-поворот+кроп+обрезка кадров): сильнее уникализирует, но
# может подрезать текст у краёв. В боте режим выбирается кнопкой на каждый запрос;
# эта переменная — значение по умолчанию для прямого вызова ядра. 1 = вкл (жёстко,
# рекомендуется против дедупа), 0 = выкл (для видео с текстом у самых краёв).
UNIQ_GEOMETRY=1

# --- лимиты Telegram ---
TELEGRAM_MAX_MB=48

# --- приём больших файлов (>20 МБ) через локальный Bot API сервер ---
# Пусто = облачный api.telegram.org (лимит скачивания входящих файлов 20 МБ).
# Подними telegram-bot-api и укажи адрес, чтобы принимать файлы до 2 ГБ:
# TELEGRAM_API_BASE=http://localhost:8081
# Если сервер запущен с флагом --local (файлы лежат на диске рядом) — включи,
# тогда бот читает файл напрямую, без скачивания по HTTP:
# TELEGRAM_API_LOCAL_MODE=1
